{
  "name": "007 - Character Engine",
  "nodes": [
    {
      "parameters": {
        "path": "character/engine",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-007",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "character-engine-007"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id AS project_id, p.title, p.language, c.id AS char_id, c.name, c.aliases, c.role, c.description, c.first_appearance FROM projects p JOIN characters c ON p.id = c.project_id WHERE p.id = $1 AND p.state = 'biblified'",
        "additionalFields": {
          "queryValues": {
            "values": [
              {
                "value": "={{ $json.body.project_id }}"
              }
            ]
          }
        }
      },
      "id": "pg-load-chars-007",
      "name": "Load Project",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 300],
      "credentials": {
        "postgres": {
          "id": "cineos-db",
          "name": "CineOS PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-chars-007",
              "leftValue": "={{ $json.rows.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-validate-007",
      "name": "Validate State",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.rows;\nconst projectId = rows[0].project_id;\n\nconst characters = rows.map(row => ({\n  id: row.char_id,\n  name: row.name,\n  aliases: row.aliases,\n  role: row.role,\n  description: row.description,\n  first_appearance: row.first_appearance\n}));\n\nreturn [{\n  json: {\n    project_id: projectId,\n    title: rows[0].title,\n    language: rows[0].language,\n    characters: characters,\n    total_characters: characters.length\n  }\n}];"
      },
      "id": "code-prepare-007",
      "name": "Execute Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_URL || 'http://localhost:11434' }}/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $env.OLLAMA_MODEL || 'llama3' }}\",\n  \"prompt\": \"Build detailed character DNA profiles for these characters from '{{ $('Execute Logic').item.json.title }}':\\n\\n{{ JSON.stringify($('Execute Logic').item.json.characters.slice(0, 8)) }}\\n\\nFor each character, generate:\\n1. physical_appearance: {age, height, build, hair, eyes, distinguishing_features, typical_clothing}\\n2. personality: {traits, mbti_type, fears, desires, flaws, strengths}\\n3. backstory: {origin, key_events, motivations, secrets}\\n4. speech_pattern: {vocabulary_level, common_phrases, accent_notes, tone}\\n5. relationships: {allies, enemies, romantic_interests}\\n6. character_arc: {starting_state, midpoint转变, ending_state, growth_direction}\\n7. visual_prompt: detailed Stable Diffusion prompt for character portrait\\n\\nReturn as JSON array with character_name as key for each entry.\",\n  \"stream\": false,\n  \"format\": \"json\"\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "http-llm-dna-007",
      "name": "Execute Logic (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "jsCode": "const responseText = $input.first().json.response || '{}';\nlet dnaProfiles = [];\n\ntry {\n  const jsonMatch = responseText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    dnaProfiles = Object.entries(parsed).map(([name, dna]) => ({\n      character_name: name,\n      dna: dna\n    }));\n  }\n} catch (e) {\n  dnaProfiles = [];\n}\n\nconst projectId = $('Execute Logic').item.json.project_id;\nconst characters = $('Execute Logic').item.json.characters;\n\n// Create visual prompt jobs\nconst imageJobs = dnaProfiles.filter(p => p.dna.visual_prompt).map(p => ({\n  json: {\n    project_id: projectId,\n    character_name: p.character_name,\n    prompt: p.dna.visual_prompt,\n    job_type: 'character_portrait',\n    status: 'pending',\n    created_at: new Date().toISOString()\n  }\n}));\n\nreturn [{\n  json: {\n    project_id: projectId,\n    dna_profiles: dnaProfiles,\n    image_jobs: imageJobs,\n    total_dna: dnaProfiles.length,\n    total_image_jobs: imageJobs.length\n  }\n}];"
      },
      "id": "code-process-dna-007",
      "name": "Execute Logic (Scenes)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE characters SET dna = $2::jsonb, visual_prompt = $3, updated_at = NOW() WHERE id = $1",
        "additionalFields": {
          "queryValues": {
            "values": [
              {
                "value": "={{ $json.char_id }}"
              },
              {
                "value": "={{ JSON.stringify($json.dna) }}"
              },
              {
                "value": "={{ $json.visual_prompt }}"
              }
            ]
          }
        }
      },
      "id": "pg-store-dna-007",
      "name": "Store Scenes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1540, 300],
      "credentials": {
        "postgres": {
          "id": "cineos-db",
          "name": "CineOS PostgreSQL"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO image_generation_jobs (project_id, entity_type, entity_id, prompt, status, created_at) VALUES ($1, 'character', $2, $3, 'pending', NOW())",
        "additionalFields": {
          "queryValues": {
            "values": [
              {
                "value": "={{ $('Execute Logic (Scenes)').item.json.project_id }}"
              },
              {
                "value": "={{ $json.character_name }}"
              },
              {
                "value": "={{ $json.prompt }}"
              }
            ]
          }
        }
      },
      "id": "pg-img-jobs-007",
      "name": "Update Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1760, 300],
      "credentials": {
        "postgres": {
          "id": "cineos-db",
          "name": "CineOS PostgreSQL"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE bibles SET locked = true, updated_at = NOW() WHERE project_id = $1 AND bible_type IN ('character', 'characters')",
