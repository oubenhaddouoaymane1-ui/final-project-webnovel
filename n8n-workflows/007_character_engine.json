        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'characterized', project_id: $('Execute Logic (Scenes)').item.json.project_id, dna_profiles: $('Execute Logic (Scenes)').item.json.total_dna, image_jobs: $('Execute Logic (Scenes)').item.json.total_image_jobs }) }}"
      },
      "id": "respond-007",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [3080, 300]
    },
