      "position": [1980, 300],
      "credentials": {
        "postgres": {
          "id": "cineos-db",
          "name": "CineOS PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE projects SET state = 'characterized', updated_at = NOW() WHERE id = $1",
        "additionalFields": {
          "queryValues": {
            "values": [
              {
                "value": "={{ $('Execute Logic (Scenes)').item.json.project_id }}"
