        "query": "INSERT INTO events (project_id, event_type, payload, created_at) VALUES ($1, 'characters_characterized', $2::jsonb, NOW())",
        "additionalFields": {
          "queryValues": {
            "values": [
              {
                "value": "={{ $('Execute Logic (Scenes)').item.json.project_id }}"
              },
              {
                "value": "={{ JSON.stringify({ state: 'characterized', characters_count: $('Execute Logic (Scenes)').item.json.total_dna, image_jobs_created: $('Execute Logic (Scenes)').item.json.total_image_jobs }) }}"
              }
            ]
          }
        }
      },
      "id": "pg-event-007",
      "name": "Trigger Orchestrator",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2420, 300],
      "credentials": {
        "postgres": {
          "id": "cineos-db",
          "name": "CineOS PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.chat_id }}",
        "text": "=👤 Character engine complete!\n\n📋 Project: {{ $('Execute Logic (Scenes)').item.json.project_id }}\n🧬 DNA profiles: {{ $('Execute Logic (Scenes)').item.json.total_dna }}\n🖼️ Image jobs: {{ $('Execute Logic (Scenes)').item.json.total_image_jobs }}\n🔒 Character bibles locked"
      },
      "id": "tg-007",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2640, 300],
