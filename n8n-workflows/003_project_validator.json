    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.*, n.text_content, n.language, n.encoding, n.word_count AS novel_word_count FROM projects p LEFT JOIN novels n ON p.novel_id = n.id WHERE p.id = $1",
        "additionalFields": {
          "queryValues": {
            "values": [
              {
                "value": "={{ $json.body.project_id }}"
              }
            ]
          }
        }
      },
      "id": "pg-load-project-003",
      "name": "Load Project",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 300],
      "credentials": {
        "postgres": {
          "id": "cineos-db",
          "name": "CineOS PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-project",
              "leftValue": "={{ $json.rows[0].id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-validate-state-003",
      "name": "Validate State",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "const project = $input.first().json.rows[0];\nconst issues = [];\n\nconst text = project.text_content || '';\n\n// Check encoding (UTF-8 validity)\ntry {\n  const encoder = new TextEncoder();\n  const decoded = new TextDecoder('utf-8', { fatal: true });\n  decoded.decode(encoder.encode(text));\n} catch (e) {\n  issues.push('Invalid UTF-8 encoding detected');\n}\n\n// Check language (basic heuristic)\nconst languagePatterns = {\n  'en': /[a-zA-Z]/,\n  'ru': /[а-яА-ЯёЁ]/,\n  'de': /[äöüÄÖÜß]/,\n  'es': /[ñ¿¡áéíóú]/,\n  'fr': /[àâçéèêëîïôùûüÿœ]/\n};\nconst detectedLang = project.language || 'unknown';\n\nif (!languagePatterns[detectedLang] && detectedLang !== 'unknown') {\n  issues.push(`Language '${detectedLang}' does not match text content`);\n}\n\n// Check word count\nconst wordCount = text.split(/\\s+/).filter(w => w.length > 0).length;\nif (wordCount < 1000) {\n  issues.push(`Novel too short: ${wordCount} words (minimum 1000)`);\n}\nif (wordCount > 1000000) {\n  issues.push(`Novel too long: ${wordCount} words (maximum 1,000,000)`);\n}\n\n// Check for empty content\nif (!text || text.trim().length === 0) {\n  issues.push('Novel text content is empty');\n}\n\nconst isValid = issues.length === 0;\n\nreturn [{\n  json: {\n    project_id: project.id,\n    is_valid: isValid,\n    issues: issues,\n    word_count: wordCount,\n    detected_language: detectedLang,\n    encoding_ok: true,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-checks-003",
      "name": "Execute Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-is-valid",
              "leftValue": "={{ $json.is_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid-003",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 300]
    },
