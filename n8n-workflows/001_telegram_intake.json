              "output": 2,
              "renameOutput": "STATUS"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.message.text }}",
                    "operation": "startsWith",
                    "value2": "/cancel"
                  }
                ]
              },
              "output": 3,
