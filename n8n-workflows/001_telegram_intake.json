      "id": "node-20-download-file",
      "name": "Download File",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1050, 550],
      "credentials": {
        "telegramApi": {
          "id": "cineos-telegram",
          "name": "CineOS Telegram"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\nconst fileData = $input.first().json.data;\nconst fileName = $input.first().json.message.document.file_name;\nconst fileSize = $input.first().json.message.document.file_size;\n\n// Validate file\nif (!fileName.endsWith('.txt')) {\n  throw new Error('Only .txt files are supported');\n}\n\nif (fileSize > 10 * 1024 * 1024) {\n  throw new Error('File too large (max 10MB)');\n}\n\n// Save to temp\nconst tempDir = '/tmp/cineos_intake';\nif (!fs.existsSync(tempDir)) {\n  fs.mkdirSync(tempDir, { recursive: true });\n}\n\nconst filePath = path.join(tempDir, fileName);\nfs.writeFileSync(filePath, fileData);\n\nreturn [{ json: { file_path: filePath, file_size: fileSize, file_name: fileName } }];"
      },
      "id": "node-50-validate-file",
      "name": "Validate File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1250, 550]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\n\nconst filePath = $input.first().json.file_path;\nconst raw = fs.readFileSync(filePath);\n\n// Detect encoding\nlet text = null;\nlet encoding = null;\nconst encodings = ['utf-8', 'utf-8-sig', 'latin-1', 'cp1252', 'iso-8859-1'];\n\nfor (const enc of encodings) {\n  try {\n    text = raw.toString(enc);\n    encoding = enc;\n    break;\n  } catch (e) {\n    continue;\n  }\n}\n\nif (!text) {\n  throw new Error('Cannot detect encoding');\n}\n\n// Detect language\nconst arabicChars = (text.match(/[\\u0600-\\u06FF]/g) || []).length;\nconst totalChars = text.length;\nconst ratio = arabicChars / totalChars;\nlet language = 'en';\nif (ratio > 0.5) language = 'ar';\nelse if (ratio > 0.1) language = 'mixed';\n\n// Normalize text\nconst unicodedata = require('unicodedata');\ntext = text.replace(/\\r\\n/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').replace(/[ \\t]+/g, ' ').trim();\n\nconst title = text.split('\\n')[0].substring(0, 200);\nconst wordCount = text.split(/\\s+/).length;\nconst charCount = text.length;\n\nif (wordCount < 50) throw new Error('Too few words (minimum 50)');\nif (wordCount > 500000) throw new Error('Too many words (maximum 500,000)');\n\nreturn [{\n  json: {\n    raw_text: raw.toString('binary'),\n    cleaned_text: text,\n    title: title,\n    word_count: wordCount,\n    char_count: charCount,\n    encoding: encoding,\n    language: language,\n    file_path: $input.first().json.file_path\n  }\n}];"
      },
