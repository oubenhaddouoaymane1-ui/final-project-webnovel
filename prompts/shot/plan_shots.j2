      "composition": {"framing": "<string>", "depth_of_field": "<string>", "focus_subject": "<string>", "foreground_elements": ["<string>"], "background_elements": ["<string>"], "leading_lines": "<string>"},
      "lighting": {"key_light": "<string>", "fill_light": "<string>", "rim_light": "<string>", "practical_lights": ["<string>"], "overall_mood": "<string>", "color_temperature": "<string>", "shadows": "<string>", "contrast": "<string>"},
      "subjects": [{"character_id": "<string>", "position": "<string>", "action": "<string>", "expression": "<string>", "eye_line": "<string>"}],
