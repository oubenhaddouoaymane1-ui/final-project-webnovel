##############################################################################
# CineOS — Environment Variables (Cloud-First)
# Copy to .env and fill in your values.
# Heavy AI runs on free cloud services — no GPU needed locally.
##############################################################################

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cineos
POSTGRES_USER=cineos
POSTGRES_PASSWORD=changeme_in_production

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── n8n ─────────────────────────────────────────────────────────────────────
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_API_KEY=
N8N_ENCRYPTION_KEY=changeme_random_32_chars

# ── Webhook URL ─────────────────────────────────────────────────────────────
# If exposing n8n externally (for Colab callbacks), set your public URL
WEBHOOK_URL=http://localhost:5678/

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── CineOS Defaults ────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
QUALITY_THRESHOLD=0.80
MAX_RETRY=3
MAX_PARALLEL_JOBS=4

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=UTC

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUD SERVICES — All free-tier options
# ═══════════════════════════════════════════════════════════════════════════════

# ── OpenRouter (free LLM + Vision) ──────────────────────────────────────────
# Sign up: https://openrouter.ai — free tier available
OPENROUTER_KEY=
OPENROUTER_API_KEY=

# ── HuggingFace (free image generation + models) ────────────────────────────
# Sign up: https://huggingface.co/settings/tokens — free Inference API
HF_API_KEY=

# ── Google Colab (optional — for heavy GPU tasks) ──────────────────────────
# When you need ComfyUI, RealESRGAN, LivePortrait, or Kokoro TTS:
# 1. Open the CineOS Colab notebook
# 2. Run the GPU cell
# 3. Paste the ngrok URL below
COLAB_COMFYUI_ENDPOINT=
COLAB_ESRGAN_ENDPOINT=
COLAB_LIVEPORTRAIT_ENDPOINT=
COLAB_KOKORO_ENDPOINT=
COLAB_API_KEY=
COLAB_WARMUP_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY (generated on first run)
# ═══════════════════════════════════════════════════════════════════════════════
CINEOS_API_KEY_SALT=changeme_random_salt_string
CINEOS_WEBHOOK_SECRET=changeme_webhook_secret_32chars
CINEOS_ENCRYPTION_KEY=changeme_hex_64_chars_for_fernet
CINEOS_IP_WHITELIST=
