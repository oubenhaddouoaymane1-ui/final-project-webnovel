# CineOS Docker Compose Environment Variables
# Copy this file to .env and modify as needed

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=cineos
POSTGRES_PASSWORD=cineos_secret

# n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# n8n Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cineos_admin

# Redis
REDIS_PORT=6379

# Timezone
TZ=UTC

# Telegram Bot (for bridge)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=http://localhost:5678/webhook/telegram
