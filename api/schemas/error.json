{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineos.dev/schemas/error.json",
  "title": "Error Response",
  "description": "Standard error response returned by all CineOS API endpoints on failure.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code. Use this for programmatic error handling.",
          "examples": ["VALIDATION_ERROR", "NOT_FOUND", "BACKEND_UNAVAILABLE", "RATE_LIMITED", "UNAUTHORIZED", "INTERNAL_ERROR", "UNPROCESSABLE_ENTITY", "CONFLICT", "TIMEOUT"]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error description",
          "examples": ["Invalid request body: 'prompt' must not be empty"]
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "Dot-notation path to the offending field",
                "examples": ["payload.prompt"]
              },
              "message": {
                "type": "string",
                "description": "Field-specific error description",
                "examples": ["must not be empty"]
              },
              "code": {
                "type": "string",
                "description": "Field-level error code",
                "examples": ["REQUIRED", "MIN_LENGTH", "INVALID_ENUM", "OUT_OF_RANGE"]
              },
              "received": {
                "description": "The value that was received (for debugging)"
              }
            },
            "required": ["field", "message"]
          },
          "description": "Detailed field-level validation errors",
          "examples": [
            {
              "field": "payload.prompt",
              "message": "must not be empty",
              "code": "REQUIRED"
            },
            {
              "field": "payload.width",
              "message": "must be between 256 and 4096",
              "code": "OUT_OF_RANGE",
              "received": 100
            }
          ]
        },
        "request_id": {
          "type": "string",
          "description": "Unique request ID for log correlation and debugging",
          "examples": ["req-01H8X9A3B-abc123"]
        },
        "documentation_url": {
          "type": "string",
          "format": "uri",
          "nullable": true,
          "description": "Link to relevant API documentation",
          "examples": ["https://docs.cineos.dev/errors#VALIDATION_ERROR"]
        },
        "retry_after_seconds": {
          "type": "integer",
          "nullable": true,
          "description": "Seconds to wait before retrying (only present on 429 responses)",
          "examples": [30]
        }
      },
      "required": ["code", "message"]
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "error": {
        "code": "VALIDATION_ERROR",
        "message": "Invalid request body",
        "details": [
          {
            "field": "payload.prompt",
            "message": "must not be empty",
            "code": "REQUIRED"
          },
          {
            "field": "payload.width",
            "message": "must be between 256 and 4096",
            "code": "OUT_OF_RANGE",
            "received": 100
          }
        ],
        "request_id": "req-01H8X9A3B-abc123",
        "documentation_url": "https://docs.cineos.dev/errors#VALIDATION_ERROR"
      }
    },
    {
      "error": {
        "code": "NOT_FOUND",
        "message": "Worker with ID 'wk-nonexistent' not found",
        "request_id": "req-01H8X9A3B-def456"
      }
    },
    {
      "error": {
        "code": "RATE_LIMITED",
        "message": "Rate limit exceeded. Retry after 30 seconds.",
        "request_id": "req-01H8X9A3B-ghi789",
        "retry_after_seconds": 30
      }
    },
    {
      "error": {
        "code": "BACKEND_UNAVAILABLE",
        "message": "All image generation backends failed: pollinations returned HTTP 503",
        "request_id": "req-01H8X9A3B-jkl012",
        "documentation_url": "https://docs.cineos.dev/errors#BACKEND_UNAVAILABLE"
      }
    }
  ]
}
