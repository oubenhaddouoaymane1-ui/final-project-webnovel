{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineos.dev/schemas/review.json",
  "title": "Quality Review",
  "description": "Quality review result for a generated asset (image, audio, animation, or video).",
  "type": "object",
  "required": ["review_id", "entity_type", "entity_id", "project_id", "status"],
  "properties": {
    "review_id": {
      "type": "string",
      "description": "Unique review identifier",
      "examples": ["rev-01H8X9A3B"]
    },
    "entity_type": {
      "type": "string",
      "enum": ["image", "audio", "animation", "video", "scene"],
      "description": "Type of entity being reviewed",
      "examples": ["image"]
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity under review",
      "examples": ["img-01H8X9A3B"]
    },
    "project_id": {
      "type": "string",
      "description": "Reference to the owning project",
      "examples": ["proj-01H8X9A3B"]
    },
    "scene_id": {
      "type": "string",
      "nullable": true,
      "description": "Optional reference to the associated scene",
      "examples": ["scn-01H8X9A3B"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "processing", "completed", "failed"],
      "description": "Current review status",
      "examples": ["completed"]
    },
    "review_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "visual_quality",
          "audio_quality",
          "character_consistency",
          "world_consistency",
          "scene_alignment",
          "novel_fidelity"
        ]
      },
      "description": "Criteria evaluated in this review",
      "examples": [["visual_quality", "character_consistency", "world_consistency"]]
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "nullable": true,
      "description": "Weighted overall quality score",
      "examples": [8.5]
    },
    "scores": {
      "type": "object",
      "nullable": true,
      "description": "Individual criterion scores",
      "properties": {
        "visual_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Sharpness, composition, aesthetic quality"
        },
        "audio_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Clarity, naturalness, volume consistency"
        },
        "character_consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "How well character features match their DNA profile"
        },
        "world_consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "How well visual elements match the world bible"
        },
        "scene_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "How well the asset captures the scene's intent"
        },
        "novel_fidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Fidelity to the original novel text"
        }
      },
      "examples": [
        {
          "visual_quality": 9.0,
          "character_consistency": 8.0,
          "world_consistency": 8.5,
          "scene_alignment": 8.5,
          "novel_fidelity": 8.0
        }
      ]
    },
    "passed": {
      "type": "boolean",
      "description": "Whether the entity passed all quality thresholds",
      "examples": [true]
    },
    "threshold_used": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "The quality threshold that was applied",
      "default": 7.0,
      "examples": [7.0]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific issues found during review",
      "default": [],
      "examples": [["Character hair color does not match DNA: expected blonde, got brown"]]
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested improvements",
      "default": [],
      "examples": [["Consider regenerating with a more constrained prompt including hair color"]]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "ISO 8601 timestamp of review completion",
      "examples": ["2026-07-26T10:20:00Z"]
    },
    "reviewer": {
      "type": "string",
      "description": "Identifier of the reviewing system or worker",
      "examples": ["quality_worker-wk-01H8X9A3C"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp",
      "examples": ["2026-07-26T10:19:00Z"]
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "review_id": "rev-01H8X9A3B",
      "entity_type": "image",
      "entity_id": "img-01H8X9A3B",
      "project_id": "proj-01H8X9A3B",
      "scene_id": "scn-01H8X9A3B",
      "status": "completed",
      "review_criteria": ["visual_quality", "character_consistency", "world_consistency"],
      "overall_score": 8.5,
      "scores": {
        "visual_quality": 9.0,
        "character_consistency": 8.0,
        "world_consistency": 8.5,
        "scene_alignment": 8.5,
        "novel_fidelity": 8.0
      },
      "passed": true,
      "threshold_used": 7.0,
      "issues": [],
      "recommendations": [],
      "reviewed_at": "2026-07-26T10:20:00Z",
      "reviewer": "quality_worker-wk-01H8X9A3C",
      "created_at": "2026-07-26T10:19:00Z"
    }
  ]
}
