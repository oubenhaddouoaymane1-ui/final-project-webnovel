##############################################################################
# CineOS — Cloud Deployment Environment Variables
# Copy this to .env.cloud and fill in values before deploying.
# Used with: docker compose -f docker-compose.yml -f docker-compose.cloud.yml
##############################################################################

# ── PostgreSQL (managed service) ──────────────────────────────────────────
POSTGRES_HOST=your-pg-host.example.com
POSTGRES_PORT=5432
POSTGRES_DB=cineos
POSTGRES_USER=cineos
POSTGRES_PASSWORD=changeme_random_password

# ── Redis (managed service) ──────────────────────────────────────────────
REDIS_HOST=your-redis-host.example.com
REDIS_PORT=6379

# ── n8n ──────────────────────────────────────────────────────────────────
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_random_password
N8N_API_KEY=
N8N_ENCRYPTION_KEY=changeme_random_32_hex_chars

# ── Webhook URL (your public domain or ngrok) ────────────────────────────
WEBHOOK_URL=https://your-domain.com/

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── CineOS Defaults ─────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
QUALITY_THRESHOLD=0.80
MAX_RETRY=3
MAX_PARALLEL_JOBS=4

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=UTC

# ════════════════════════════════════════════════════════════════════════════
# CLOUD SERVICES — All free-tier options
# ════════════════════════════════════════════════════════════════════════════

# ── OpenRouter (free LLM + Vision) ───────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ── HuggingFace (free image generation) ──────────────────────────────────
HF_API_KEY=hf_your_token_here

# ── Pollinations (zero-config image generation) ──────────────────────────
POLLINATIONS_ENABLED=true

# ── Google Colab (optional — for ComfyUI + FLUX, RealESRGAN, LivePortrait) ─
COLAB_COMFYUI_ENDPOINT=
COLAB_ESRGAN_ENDPOINT=
COLAB_LIVEPORTRAIT_ENDPOINT=
COLAB_API_KEY=
COLAB_WARMUP_URL=

# ════════════════════════════════════════════════════════════════════════════
# SECURITY
# ════════════════════════════════════════════════════════════════════════════
CINEOS_API_KEY_SALT=changeme_random_salt
CINEOS_WEBHOOK_SECRET=changeme_webhook_secret_32chars
CINEOS_ENCRYPTION_KEY=changeme_hex_64_chars_for_fernet
CINEOS_IP_WHITELIST=

# ════════════════════════════════════════════════════════════════════════════
# CLOUD BRIDGE
# ════════════════════════════════════════════════════════════════════════════
CLOUD_BRIDGE_URL=http://cloud_bridge:8600
